<odoo>
    <record id='gps_geofences_view_form' model='ir.ui.view'>
        <field name="name">gps_geofences.form</field>
        <field name="model">gps_geofences</field>
        <field name="arch" type="xml">
            <form string="GPS">
                <sheet>
                    <notebook>
                        <page string="Geofence">
                            <group col="4">
                                <field name="name"/>
                                <field name="description"/>      
                                                    
                                <field name="color"/>
                                <field name="hidden"/>
                                <!--
                                <field name="manager_id"/>                                 
                                -->
                                <field name="company_ids" widget="many2many_tags"/>                        

                            </group>
                            <div style="position:relative; width:100%; height:400px; display:block; background-color:#cccc;">
                                <field name="map" widget="map_drawing_shape"/>    
                            </div>
                            <section class="s_google_map pt256 pb256" data-map-type="ROADMAP" data-map-color="" data-map-zoom="12" data-map-gps="(50.854975,4.3753899)" data-pin-style="flat">
                                <div class="map_container"/>
                            </section>                                                
                                                    
                        </page>
                        <page string="Coordinates">
                            <field name="area"/>
                        </page>
                    </notebook>
                </sheet>                                                    
            </form>
        </field>
    </record>
    <record id='gps_geofences_view_tree' model='ir.ui.view'>
        <field name="name">gps_geofences.tree</field>
        <field name="model">gps_geofences</field>
        <field name="arch" type="xml">
            <tree string="Models">          
                    <field name="name"/>
                    <field name="description"/>                          
                    <field name="color"/>
                    <field name="hidden"/>
                    <field name="company_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
</odoo>
